<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>足球卡牌游戏 - 可交互网页Demo</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@600;700&family=Montserrat:wght@800;900&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background-color: #0f141c;
      color: #ffffff;
      user-select: none;
    }
    .font-number { font-family: 'Chakra Petch', sans-serif; }
    .font-title { font-family: 'Montserrat', sans-serif; }
    .card-shadow { box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.6); }
    .pitch-bg { background: radial-gradient(circle at center, #1b4d3e 0%, #0d281e 100%); }
    
    /* 卡牌动画与过渡 */
    .card-item {
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .card-item.selected {
      transform: translateY(-16px);
      box-shadow: 0 0 15px rgba(52, 211, 153, 0.5);
    }
    .card-bounce {
      animation: bounce 0.4s ease-in-out;
    }
    @keyframes bounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-24px) scale(1.05); }
    }
  </style>
</head>
<body class="min-h-screen p-4 md:p-6 flex flex-col justify-between">

  <!-- 1. 顶部状态栏 -->
  <header class="w-full max-w-6xl mx-auto flex justify-between items-center bg-slate-900/80 border border-slate-700/60 rounded-xl p-4 mb-4 backdrop-blur-md">
    <div class="flex items-center space-x-4 md:space-x-6">
      <div class="text-xs uppercase tracking-widest text-slate-400">
        关卡: <span class="text-emerald-400 font-bold text-sm">S1-1 试训赛</span>
      </div>
      <div class="h-4 w-[1px] bg-slate-700"></div>
      <div class="text-xs uppercase tracking-widest text-slate-400">
        出牌: <span id="kickouts-count" class="font-number text-amber-400 font-bold text-base">4/4</span>
      </div>
      <div class="text-xs uppercase tracking-widest text-slate-400">
        弃牌: <span id="discards-count" class="font-number text-red-400 font-bold text-base">3/3</span>
      </div>
    </div>
    <div class="flex items-center space-x-2 bg-amber-500/10 border border-amber-500/30 px-3 py-1.5 rounded-lg">
      <span class="text-amber-400 text-sm">💼</span>
      <span class="font-number text-amber-400 font-bold text-lg">$15</span>
    </div>
  </header>

  <!-- 2. 主战斗区域 -->
  <main class="w-full max-w-6xl mx-auto flex-1 grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
    
    <!-- 左侧：战术与即时计分看板 -->
    <section class="md:col-span-4 flex flex-col gap-4">
      <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-3">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2 flex justify-between">
          <span>主帅 (Joker)</span>
          <span class="text-purple-400 font-number">1/5</span>
        </div>
        <div class="bg-gradient-to-br from-slate-900 via-purple-950/40 to-slate-900 border-2 border-purple-500/80 rounded-lg p-3 flex items-center gap-3">
          <div class="w-10 h-14 bg-purple-900/50 border border-purple-400/50 rounded flex items-center justify-center text-xl shrink-0">👔</div>
          <div>
            <div class="font-bold text-sm text-purple-200">安切洛蒂</div>
            <p class="text-xs text-slate-300 mt-0.5">阵型含3种及以上位置时，倍率 <span class="text-rose-400 font-bold font-number">+6</span></p>
          </div>
        </div>
      </div>

      <!-- 即时计分看板 -->
      <div class="bg-slate-900 border-2 border-slate-700/80 rounded-xl p-4 card-shadow flex flex-col gap-3">
        <div class="flex justify-between items-center border-b border-slate-800 pb-2">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">拟选阵型</span>
          <span id="poker-hand-name" class="text-xs font-bold text-emerald-400 bg-emerald-950/60 border border-emerald-500/30 px-2 py-0.5 rounded">未选牌</span>
        </div>

        <div class="flex items-center justify-between py-2">
          <div class="flex flex-col items-center flex-1">
            <span class="text-[10px] text-sky-400 font-bold uppercase mb-1">基础分 (CHIPS)</span>
            <div id="display-chips" class="bg-sky-950/80 border-2 border-sky-400/80 text-sky-300 font-number font-bold text-2xl w-full py-1.5 rounded-lg text-center">0</div>
          </div>
          <span class="text-slate-500 font-bold text-xl px-2 mt-4">×</span>
          <div class="flex flex-col items-center flex-1">
            <span class="text-[10px] text-rose-400 font-bold uppercase mb-1">倍率 (MULT)</span>
            <div id="display-mult" class="bg-rose-950/80 border-2 border-rose-500/80 text-rose-300 font-number font-bold text-2xl w-full py-1.5 rounded-lg text-center">0</div>
          </div>
        </div>

        <div class="bg-slate-950/80 border border-slate-800 rounded-lg p-2.5 flex justify-between items-center">
          <span class="text-xs text-slate-400 font-medium">预估得分:</span>
          <span id="display-score" class="font-number font-bold text-amber-400 text-xl tracking-wider">0</span>
        </div>

        <div>
          <div class="flex justify-between text-xs mb-1">
            <span class="text-slate-400">比赛目标分</span>
            <span class="font-number text-slate-300"><span id="current-score">0</span> / <span id="target-score">1000</span></span>
          </div>
          <div class="w-full bg-slate-950 h-2.5 rounded-full overflow-hidden border border-slate-800">
            <div id="score-progress" class="bg-gradient-to-r from-emerald-500 to-amber-400 h-full w-0 transition-all duration-500 rounded-full"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 右侧：球场出牌与手牌区 -->
    <section class="md:col-span-8 flex flex-col gap-4">
      <!-- 绿茵出牌区 -->
      <div class="pitch-bg border-2 border-emerald-600/40 rounded-2xl p-4 min-h-[200px] flex flex-col justify-between items-center relative overflow-hidden card-shadow">
        <div class="text-xs font-bold uppercase tracking-widest text-emerald-300/60 bg-emerald-950/40 px-3 py-1 rounded-full border border-emerald-500/20">
          球场出牌区
        </div>
        <div id="played-cards-container" class="flex justify-center items-center gap-3 my-4 min-h-[128px]">
          <span class="text-xs text-emerald-400/50">点击下方手牌选择组合 (最多 5 张)</span>
        </div>
        <div class="flex gap-4">
          <button id="discard-btn" onclick="discardSelected()" class="px-5 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-600 text-slate-300 font-bold rounded-xl text-sm transition">弃牌</button>
          <button id="shoot-btn" onclick="playHand()" class="px-8 py-2 bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-400 text-slate-950 font-title font-black text-base rounded-xl transition shadow-[0_0_15px_rgba(16,185,129,0.4)]">射门 / 出牌 !</button>
        </div>
      </div>

      <!-- 手牌展示区 -->
      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-4">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3 flex justify-between">
          <span>手牌区</span>
          <span id="selected-count" class="text-emerald-400 font-number">已选择 0/5</span>
        </div>
        <div id="hand-cards-container" class="flex justify-center flex-wrap gap-2 md:gap-3"></div>
      </div>
    </section>

  </main>

  <!-- 3. JavaScript 交互核心逻辑 -->
  <script>
    // 基础配置与数据定义
    const POSITIONS = {
      FW: { name: '前锋', color: 'border-rose-500 text-rose-400 bg-rose-500/20' },
      MF: { name: '中场', color: 'border-emerald-500 text-emerald-400 bg-emerald-500/20' },
      DF: { name: '后场', color: 'border-sky-500 text-sky-400 bg-sky-500/20' },
      GK: { name: '门将', color: 'border-amber-500 text-amber-400 bg-amber-500/20' }
    };

    const HAND_PATTERNS = {
      GOLDEN_AXIS: { name: '黄金中轴线', baseChips: 60, baseMult: 4 },
      TRIPLE: { name: '三连攻防', baseChips: 30, baseMult: 3 },
      PAIR: { name: '双核联动', baseChips: 10, baseMult: 2 },
      MULTI_LINE: { name: '多线协同', baseChips: 15, baseMult: 2 },
      SINGLE: { name: '单兵作战', baseChips: 5, baseMult: 1 }
    };

    let gameState = {
      kickouts: 4,
      discards: 3,
      currentScore: 0,
      targetScore: 1000,
      handCards: [],
      selectedIndices: [],
      isAnimating: false
    };

    // 生成发牌
    function createRandomCard(id) {
      const posKeys = Object.keys(POSITIONS);
      const pos = posKeys[Math.floor(Math.random() * posKeys.length)];
      const value = Math.floor(Math.random() * 13) + 2; // 2 ~ 14 (A)
      return { id, pos, value };
    }

    function initHand() {
      gameState.handCards = [];
      for (let i = 0; i < 8; i++) {
        gameState.handCards.push(createRandomCard(Date.now() + i));
      }
      gameState.selectedIndices = [];
      renderHand();
      updateScoreRadar();
    }

    // 渲染手牌
    function renderHand() {
      const container = document.getElementById('hand-cards-container');
      container.innerHTML = '';
      
      gameState.handCards.forEach((card, index) => {
        const isSelected = gameState.selectedIndices.includes(index);
        const posInfo = POSITIONS[card.pos];
        const valText = card.value === 11 ? 'J' : card.value === 12 ? 'Q' : card.value === 13 ? 'K' : card.value === 14 ? 'A' : card.value;

        const cardEl = document.createElement('div');
        cardEl.className = `card-item w-20 h-28 md:w-24 md:h-36 bg-slate-900 border-2 ${posInfo.color.split(' ')[0]} rounded-xl p-2 flex flex-col justify-between cursor-pointer card-shadow ${isSelected ? 'selected' : ''}`;
        cardEl.onclick = () => toggleSelectCard(index);

        cardEl.innerHTML = `
          <div class="flex justify-between items-start">
            <span class="font-number font-bold text-base md:text-lg ${posInfo.color.split(' ')[1]}">${valText}</span>
            <span class="text-[9px] font-bold ${posInfo.color} px-1 rounded">${card.pos}</span>
          </div>
          <div class="text-xl md:text-2xl text-center">⚽</div>
          <div class="border-t border-slate-800 pt-0.5 text-center">
            <span class="text-[9px] font-bold ${posInfo.color.split(' ')[1]}">${posInfo.name}</span>
          </div>
        `;
        container.appendChild(cardEl);
      });

      document.getElementById('selected-count').innerText = `已选择 ${gameState.selectedIndices.length}/5`;
    }

    // 选择/取消选择手牌
    function toggleSelectCard(index) {
      if (gameState.isAnimating) return;
      
      const idxInSelected = gameState.selectedIndices.indexOf(index);
      if (idxInSelected > -1) {
        gameState.selectedIndices.splice(idxInSelected, 1);
      } else {
        if (gameState.selectedIndices.length < 5) {
          gameState.selectedIndices.push(index);
        }
      }
      renderHand();
      updateScoreRadar();
    }

    // 牌型判定与计算逻辑
    function evaluateSelectedHand() {
      const selectedCards = gameState.selectedIndices.map(i => gameState.handCards[i]);
      if (selectedCards.length === 0) return null;

      const posCounts = {};
      let totalCardPoints = 0;

      selectedCards.forEach(c => {
        posCounts[c.pos] = (posCounts[c.pos] || 0) + 1;
        totalCardPoints += c.value;
      });

      const uniquePositions = Object.keys(posCounts).length;
      let pattern = HAND_PATTERNS.SINGLE;

      // 判定黄金中轴线 (前+中+后+门各1)
      if (uniquePositions === 4) {
        pattern = HAND_PATTERNS.GOLDEN_AXIS;
      } else {
        const maxSamePos = Math.max(...Object.values(posCounts));
        if (maxSamePos >= 3) pattern = HAND_PATTERNS.TRIPLE;
        else if (maxSamePos === 2) pattern = HAND_PATTERNS.PAIR;
        else if (uniquePositions >= 2) pattern = HAND_PATTERNS.MULTI_LINE;
      }

      // 主帅加成逻辑 (安切洛蒂：3种以上位置倍率+6)
      let managerBonusMult = uniquePositions >= 3 ? 6 : 0;

      const chips = pattern.baseChips + totalCardPoints;
      const mult = pattern.baseMult + managerBonusMult;

      return { patternName: pattern.name, chips, mult, totalScore: chips * mult };
    }

    // 动态更新看板
    function updateScoreRadar() {
      const evalResult = evaluateSelectedHand();
      if (!evalResult) {
        document.getElementById('poker-hand-name').innerText = '未选牌';
        document.getElementById('display-chips').innerText = '0';
        document.getElementById('display-mult').innerText = '0';
        document.getElementById('display-score').innerText = '0';
        return;
      }

      document.getElementById('poker-hand-name').innerText = evalResult.patternName;
      document.getElementById('display-chips').innerText = evalResult.chips;
      document.getElementById('display-mult').innerText = evalResult.mult;
      document.getElementById('display-score').innerText = evalResult.totalScore.toLocaleString();
    }

    // 弃牌逻辑
    function discardSelected() {
      if (gameState.isAnimating || gameState.discards <= 0 || gameState.selectedIndices.length === 0) return;

      gameState.discards--;
      document.getElementById('discards-count').innerText = `${gameState.discards}/3`;

      // 替换被弃掉的卡牌
      gameState.selectedIndices.sort((a, b) => b - a).forEach(index => {
        gameState.handCards.splice(index, 1);
      });
      while (gameState.handCards.length < 8) {
        gameState.handCards.push(createRandomCard(Date.now() + Math.random()));
      }

      gameState.selectedIndices = [];
      renderHand();
      updateScoreRadar();
    }

    // 出牌与计分动画播放
    async function playHand() {
      const evalResult = evaluateSelectedHand();
      if (gameState.isAnimating || gameState.kickouts <= 0 || !evalResult) return;

      gameState.isAnimating = true;
      gameState.kickouts--;
      document.getElementById('kickouts-count').innerText = `${gameState.kickouts}/4`;

      // 将选中的卡牌移入出牌区
      const playedContainer = document.getElementById('played-cards-container');
      playedContainer.innerHTML = '';
      
      const selectedCards = gameState.selectedIndices.map(i => gameState.handCards[i]);
      const cardNodes = [];

      selectedCards.forEach(card => {
        const posInfo = POSITIONS[card.pos];
        const valText = card.value === 11 ? 'J' : card.value === 12 ? 'Q' : card.value === 13 ? 'K' : card.value === 14 ? 'A' : card.value;
        const cardEl = document.createElement('div');
        cardEl.className = `card-item w-20 h-28 bg-slate-900 border-2 ${posInfo.color.split(' ')[0]} rounded-xl p-2 flex flex-col justify-between card-shadow`;
        cardEl.innerHTML = `
          <div class="flex justify-between items-start">
            <span class="font-number font-bold text-base ${posInfo.color.split(' ')[1]}">${valText}</span>
            <span class="text-[9px] font-bold ${posInfo.color} px-1 rounded">${card.pos}</span>
          </div>
          <div class="text-xl text-center">⚽</div>
          <div class="border-t border-slate-800 pt-0.5 text-center">
            <span class="text-[9px] font-bold ${posInfo.color.split(' ')[1]}">${posInfo.name}</span>
          </div>
        `;
        playedContainer.appendChild(cardEl);
        cardNodes.push(cardEl);
      });

      // 从手牌中移除出牌，并补满 8 张
      gameState.selectedIndices.sort((a, b) => b - a).forEach(index => {
        gameState.handCards.splice(index, 1);
      });
      gameState.selectedIndices = [];
      renderHand();

      // 播放逐张卡牌跳动计分动画
      for (let i = 0; i < cardNodes.length; i++) {
        await new Promise(r => setTimeout(r, 250));
        cardNodes[i].classList.add('card-bounce');
      }

      await new Promise(r => setTimeout(r, 300));

      // 结算增加分数
      gameState.currentScore += evalResult.totalScore;
      document.getElementById('current-score').innerText = gameState.currentScore.toLocaleString();
      
      const progressPercent = Math.min(100, (gameState.currentScore / gameState.targetScore) * 100);
      document.getElementById('score-progress').style.width = `${progressPercent}%`;

      // 补充新手牌
      while (gameState.handCards.length < 8) {
        gameState.handCards.push(createRandomCard(Date.now() + Math.random()));
      }
      
      gameState.isAnimating = false;
      renderHand();
      updateScoreRadar();

      // 胜利检测
      if (gameState.currentScore >= gameState.targetScore) {
        setTimeout(() => alert('🎉 目标达成！GOAL! 胜利过关！'), 200);
      }
    }

    // 初始化运行
    initHand();
  </script>
</body>
</html>
